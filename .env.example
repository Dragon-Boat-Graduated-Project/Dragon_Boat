# Base directory on the training server
PROJECT_ROOT=/path/to/project

# Directory containing raw .mp4 files
SOURCE_VIDEOS=/path/to/videos

# Path to RF-DETR trained weights (.pth)
MODEL_CHECKPOINT=/path/to/checkpoint.pth

# Where prediction outputs (images/labels/videos) are saved
PREDICT_OUTPUT=/path/to/predict_output

# YOLO-format dataset directory
YOLO_DATASET=/path/to/yolo_dataset

# RF-DETR training dataset path
DATASET_PATH=/path/to/dataset

# Trained model output directory
MODEL_OUTPUT=/path/to/model_output
